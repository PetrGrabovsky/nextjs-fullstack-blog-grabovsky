// Nastavení generátoru Prisma Client (Prisma 7 generuje klienta přímo do projektu)
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Definice zdroje dat (databáze) pro Prisma, připojovací URL se nastavuje v prisma.config.ts
datasource db {
  provider = "postgresql"
}

// Blogový příspěvek
model Post {
  id          Int       @id @default(autoincrement()) // Primární klíč s autoincrementem
  title       String // Titulek blogového příspěvku
  description String // Obsah blogového příspěvku
  image       String // URL obrázku příspěvku (Vercel Blob)
  category    String // Kategorie příspěvku (hodnota z utils/data-mappings.ts)
  authorId    String // Identifikátor autora ve tvaru "provider_accountId"
  authorName  String // Zobrazované jméno autora
  authorImage String? // URL avataru autora
  createdAt   DateTime  @default(now()) // Datum vytvoření příspěvku
  comments    Comment[] // Komentáře k příspěvku

  // Indexy pro seznamy řazené od nejnovějšího (všechny příspěvky a příspěvky v kategorii)
  @@index([createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
}

// Komentář k blogovému příspěvku
model Comment {
  id         Int      @id @default(autoincrement()) // Primární klíč s autoincrementem
  text       String // Text komentáře
  authorId   String // Identifikátor autora ve tvaru "provider_accountId"
  authorName String // Zobrazované jméno autora
  createdAt  DateTime @default(now()) // Datum vytvoření komentáře
  postId     Int // Cizí klíč na příspěvek
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}
